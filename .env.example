POSTGRES_PASSWORD=replace-with-long-random-local-password
DATABASE_URL=postgres://hhk_app:replace-with-long-random-local-password@localhost:5432/hhk_banking
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3001
NODE_ENV=development
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA certificate (escape newlines as \n) when DATABASE_SSL=true
DATABASE_SSL_CA=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters
ADMIN_FULL_NAME=HHK Administrator
ADMIN_MOBILE=+910000000000
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Razorpay Payment Gateway (NEVER expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to frontend)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret
SUPPORT_EMAIL=support@yourdomain.com

# Phase 5: Current Affairs AI Structuring (disabled by default; NEVER expose API keys to frontend)
CA_AI_ENABLED=false
CA_AI_PROVIDER=disabled
CA_AI_MODEL=gemini-2.0-flash
CA_AI_API_KEY=
CA_AI_TIMEOUT_MS=25000
CA_AI_MAX_RETRIES=2
